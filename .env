PORT=8080
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Max requests per second
RATE_LIMIT_IP=10
RATE_LIMIT_TOKEN=100
# Specific token limits (token:limit,token:limit) - override the IP limit and the default token limit
TOKEN_LIMITS=abc123:100,free:5

# How long an offender stays blocked (Go duration: 30s, 5m, 1h)
BLOCK_DURATION=5m
